generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  COMPANY
  SCHOOL
  HOSPITAL
  ADMINISTRATION
  OTHER
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Organization {
  id                      String           @id @default(cuid())
  name                    String
  type                    OrganizationType
  logoUrl                 String?
  phone                   String?
  email                   String?
  address                 String?
  latitude                Float?
  longitude               Float?
  allowedRadiusM          Int              @default(100)
  workStartTime           String           @default("08:00")
  checkInToleranceMinutes Int              @default(30)
  workEndTime             String           @default("17:00")
  timezone                String           @default("Africa/Douala")
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  users                  User[]
  departments            Department[]
  attendances            Attendance[]

  @@index([type])
}

model User {
  id                 String        @id @default(cuid())
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  email              String        @unique
  passwordHash       String
  firstName          String
  lastName           String
  phone              String?
  matricule           String?
  role               UserRole      @default(USER)
  functionTitle      String?
  isActive           Boolean       @default(true)
  mustChangePassword Boolean       @default(false)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  attendances Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([departmentId])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name  String
  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Attendance {
  id                 String           @id @default(cuid())
  organizationId     String
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  attendanceDate DateTime @db.Date
  checkInAt      DateTime?
  checkOutAt     DateTime?

  status AttendanceStatus @default(PRESENT)

  checkInLat       Float?
  checkInLng       Float?
  checkInDistanceM Float?
  checkInAccuracyM Float?

  checkOutLat       Float?
  checkOutLng       Float?
  checkOutDistanceM Float?
  checkOutAccuracyM Float?

  verification String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, attendanceDate])
  @@index([organizationId, attendanceDate])
  @@index([userId, attendanceDate])
}

model RegistrationRequest {
  id                     String             @id @default(cuid())
  organizationName       String
  organizationType       OrganizationType
  firstName              String
  lastName               String
  email                  String             @unique
  phone                  String?
  matricule              String?
  functionTitle          String?
  className              String?
  passwordHash           String
  status                 RegistrationStatus @default(PENDING)
  reviewedAt             DateTime?
  reviewedByUserId       String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([status])
  @@index([organizationName, organizationType, status])
}
